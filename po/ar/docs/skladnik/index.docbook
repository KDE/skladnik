><shortcut
><keycombo action="simul"
>&Ctrl;&Shift;<keycap
>Z</keycap
></keycombo
></shortcut
> <guimenu
>اللعبة</guimenu
> <guimenuitem
>إعادة</guimenuitem
> </menuchoice
></term>
<listitem>
<para
><action
>أعِد آخر حركة تراجعت عنها باستخدام عنصر القائمة أعلاه.</action
></para>
</listitem>
</varlistentry>

<varlistentry>
<term
><menuchoice
><shortcut
><keycombo action="simul"
>&Ctrl;<keycap
>Q</keycap
></keycombo
